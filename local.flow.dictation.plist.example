<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.flow.dictation</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__FLOW_DIR__/launchd-start.sh</string></array>
  <key>WorkingDirectory</key><string>__FLOW_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__FLOW_DIR__/.run/launchd.log</string>
  <key>StandardErrorPath</key><string>__FLOW_DIR__/.run/launchd.log</string>
</dict>
</plist>
